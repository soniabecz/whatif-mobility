{
  "openapi": "3.1.0",
  "info": {
    "title": "WhatIf Mobility API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "Lightweight check that the server is running.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stops": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "Get Stops",
        "operationId": "get_stops_api_stops_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/StopOut"
                  },
                  "type": "array",
                  "title": "Response Get Stops Api Stops Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/routes": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "Get Routes",
        "operationId": "get_routes_api_routes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RouteOut"
                  },
                  "type": "array",
                  "title": "Response Get Routes Api Routes Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/network": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "Get Network",
        "operationId": "get_network_api_network_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetworkOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/simulations": {
      "post": {
        "tags": [
          "simulations"
        ],
        "summary": "Run Simulation",
        "description": "Simulate the scenario. Nothing is stored; the baseline is unchanged.",
        "operationId": "run_simulation_api_simulations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Scenario"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/interpret": {
      "post": {
        "tags": [
          "ai"
        ],
        "summary": "Interpret Text",
        "operationId": "interpret_text_api_ai_interpret_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InterpretRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterpretResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/journeys": {
      "post": {
        "tags": [
          "journeys"
        ],
        "summary": "Explain Journey",
        "description": "Fastest journey before and after the changes. Nothing is stored.",
        "operationId": "explain_journey_api_journeys_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JourneyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JourneyComparison"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddConnection": {
        "properties": {
          "type": {
            "type": "string",
            "const": "add_connection",
            "title": "Type"
          },
          "route_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Route Id"
          },
          "from_stop_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "From Stop Id"
          },
          "to_stop_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "To Stop Id"
          },
          "travel_time_min": {
            "type": "number",
            "maximum": 600.0,
            "exclusiveMinimum": 0.0,
            "title": "Travel Time Min"
          },
          "both_directions": {
            "type": "boolean",
            "title": "Both Directions",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "route_id",
          "from_stop_id",
          "to_stop_id",
          "travel_time_min"
        ],
        "title": "AddConnection",
        "description": "An existing route also runs directly between two stops (an extension or\na shortcut). At least one of the stops must already be on the route."
      },
      "AddStop": {
        "properties": {
          "type": {
            "type": "string",
            "const": "add_stop",
            "title": "Type"
          },
          "stop_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Stop Id"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          },
          "route_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Route Id"
          },
          "from_stop_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "From Stop Id"
          },
          "to_stop_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "To Stop Id"
          },
          "time_from_min": {
            "type": "number",
            "maximum": 600.0,
            "exclusiveMinimum": 0.0,
            "title": "Time From Min"
          },
          "time_to_min": {
            "type": "number",
            "maximum": 600.0,
            "exclusiveMinimum": 0.0,
            "title": "Time To Min"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "stop_id",
          "name",
          "lat",
          "lon",
          "route_id",
          "from_stop_id",
          "to_stop_id",
          "time_from_min",
          "time_to_min"
        ],
        "title": "AddStop",
        "description": "A new stop inserted into a route between two consecutive stops: the\nroute's buses now run from -> new stop -> to (and back, if the route runs\nboth ways). The user gives both travel times."
      },
      "ChangeFrequency": {
        "properties": {
          "type": {
            "type": "string",
            "const": "change_frequency",
            "title": "Type"
          },
          "route_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Route Id"
          },
          "headway_min": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Headway Min"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "route_id",
          "headway_min"
        ],
        "title": "ChangeFrequency",
        "description": "The route runs every ``headway_min`` minutes (affects waiting time only)."
      },
      "ChangeTravelTime": {
        "properties": {
          "type": {
            "type": "string",
            "const": "change_travel_time",
            "title": "Type"
          },
          "from_stop_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "From Stop Id"
          },
          "to_stop_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "To Stop Id"
          },
          "travel_time_min": {
            "type": "number",
            "maximum": 600.0,
            "exclusiveMinimum": 0.0,
            "title": "Travel Time Min"
          },
          "both_directions": {
            "type": "boolean",
            "title": "Both Directions",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "from_stop_id",
          "to_stop_id",
          "travel_time_min"
        ],
        "title": "ChangeTravelTime",
        "description": "Set a new travel time (minutes) on the link, for every route using it."
      },
      "CloseStop": {
        "properties": {
          "type": {
            "type": "string",
            "const": "close_stop",
            "title": "Type"
          },
          "stop_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Stop Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "stop_id"
        ],
        "title": "CloseStop",
        "description": "Nobody can board, alight or transfer at the stop; buses drive through."
      },
      "ConnectionOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "route_id": {
            "type": "string",
            "title": "Route Id"
          },
          "from_stop_id": {
            "type": "string",
            "title": "From Stop Id"
          },
          "to_stop_id": {
            "type": "string",
            "title": "To Stop Id"
          },
          "travel_time_min": {
            "type": "number",
            "title": "Travel Time Min"
          }
        },
        "type": "object",
        "required": [
          "id",
          "route_id",
          "from_stop_id",
          "to_stop_id",
          "travel_time_min"
        ],
        "title": "ConnectionOut"
      },
      "DemandWeighted": {
        "properties": {
          "unchanged_pct": {
            "type": "number",
            "title": "Unchanged Pct"
          },
          "slower_pct": {
            "type": "number",
            "title": "Slower Pct"
          },
          "faster_pct": {
            "type": "number",
            "title": "Faster Pct"
          },
          "impossible_pct": {
            "type": "number",
            "title": "Impossible Pct"
          },
          "newly_possible_pct": {
            "type": "number",
            "title": "Newly Possible Pct"
          },
          "to_or_from_closed_stop_pct": {
            "type": "number",
            "title": "To Or From Closed Stop Pct"
          },
          "average_time_before_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Time Before Min"
          },
          "average_time_after_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Time After Min"
          }
        },
        "type": "object",
        "required": [
          "unchanged_pct",
          "slower_pct",
          "faster_pct",
          "impossible_pct",
          "newly_possible_pct",
          "to_or_from_closed_stop_pct",
          "average_time_before_min",
          "average_time_after_min"
        ],
        "title": "DemandWeighted",
        "description": "The same figures weighted by INVENTED demand: a journey weighs\norigin activity x destination activity (stop levels 1-3). Only shares\nand averages: absolute passenger numbers would be fake data."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "description": "Shape of the /api/health response (validated by Pydantic)."
      },
      "InterpretRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "InterpretRequest"
      },
      "InterpretResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unclear"
            ],
            "title": "Status"
          },
          "changes": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/CloseStop"
                },
                {
                  "$ref": "#/components/schemas/RemoveConnection"
                },
                {
                  "$ref": "#/components/schemas/ChangeTravelTime"
                },
                {
                  "$ref": "#/components/schemas/ChangeFrequency"
                },
                {
                  "$ref": "#/components/schemas/AddConnection"
                },
                {
                  "$ref": "#/components/schemas/AddStop"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "add_connection": "#/components/schemas/AddConnection",
                  "add_stop": "#/components/schemas/AddStop",
                  "change_frequency": "#/components/schemas/ChangeFrequency",
                  "change_travel_time": "#/components/schemas/ChangeTravelTime",
                  "close_stop": "#/components/schemas/CloseStop",
                  "remove_connection": "#/components/schemas/RemoveConnection"
                }
              }
            },
            "type": "array",
            "title": "Changes"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "status",
          "changes",
          "message"
        ],
        "title": "InterpretResponse",
        "description": "``ok``: changes are valid for the network. ``unclear``: no changes;\n``message`` explains why or asks for clarification."
      },
      "JourneyChange": {
        "properties": {
          "origin_id": {
            "type": "string",
            "title": "Origin Id"
          },
          "destination_id": {
            "type": "string",
            "title": "Destination Id"
          },
          "time_before_min": {
            "type": "number",
            "title": "Time Before Min"
          },
          "time_after_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time After Min"
          },
          "change_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Min"
          },
          "status": {
            "type": "string",
            "enum": [
              "slower",
              "faster",
              "impossible"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "origin_id",
          "destination_id",
          "time_before_min",
          "time_after_min",
          "change_min",
          "status"
        ],
        "title": "JourneyChange",
        "description": "One origin -> destination journey whose fastest travel time changed."
      },
      "JourneyComparison": {
        "properties": {
          "origin_id": {
            "type": "string",
            "title": "Origin Id"
          },
          "destination_id": {
            "type": "string",
            "title": "Destination Id"
          },
          "before": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JourneyPlan"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JourneyPlan"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "unchanged",
              "slower",
              "faster",
              "impossible",
              "unreachable",
              "new"
            ],
            "title": "Status"
          },
          "change_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Min"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "origin_id",
          "destination_id",
          "before",
          "after",
          "status",
          "change_min",
          "reason"
        ],
        "title": "JourneyComparison"
      },
      "JourneyLeg": {
        "properties": {
          "route_id": {
            "type": "string",
            "title": "Route Id"
          },
          "stop_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Stop Ids"
          },
          "travel_time_min": {
            "type": "number",
            "title": "Travel Time Min"
          },
          "wait_min": {
            "type": "number",
            "title": "Wait Min"
          },
          "passes_closed_stop_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Passes Closed Stop Ids"
          }
        },
        "type": "object",
        "required": [
          "route_id",
          "stop_ids",
          "travel_time_min",
          "wait_min",
          "passes_closed_stop_ids"
        ],
        "title": "JourneyLeg",
        "description": "A stretch travelled on one route without changing bus."
      },
      "JourneyPlan": {
        "properties": {
          "travel_time_min": {
            "type": "number",
            "title": "Travel Time Min"
          },
          "in_vehicle_min": {
            "type": "number",
            "title": "In Vehicle Min"
          },
          "wait_min": {
            "type": "number",
            "title": "Wait Min"
          },
          "walk_min": {
            "type": "number",
            "title": "Walk Min"
          },
          "walk_start": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WalkLeg"
              },
              {
                "type": "null"
              }
            ]
          },
          "walk_end": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WalkLeg"
              },
              {
                "type": "null"
              }
            ]
          },
          "transfers": {
            "type": "integer",
            "title": "Transfers"
          },
          "transfer_penalty_min": {
            "type": "number",
            "title": "Transfer Penalty Min"
          },
          "legs": {
            "items": {
              "$ref": "#/components/schemas/JourneyLeg"
            },
            "type": "array",
            "title": "Legs"
          }
        },
        "type": "object",
        "required": [
          "travel_time_min",
          "in_vehicle_min",
          "wait_min",
          "walk_min",
          "walk_start",
          "walk_end",
          "transfers",
          "transfer_penalty_min",
          "legs"
        ],
        "title": "JourneyPlan"
      },
      "JourneyRequest": {
        "properties": {
          "origin_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Origin Id"
          },
          "destination_id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Destination Id"
          },
          "changes": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/CloseStop"
                },
                {
                  "$ref": "#/components/schemas/RemoveConnection"
                },
                {
                  "$ref": "#/components/schemas/ChangeTravelTime"
                },
                {
                  "$ref": "#/components/schemas/ChangeFrequency"
                },
                {
                  "$ref": "#/components/schemas/AddConnection"
                },
                {
                  "$ref": "#/components/schemas/AddStop"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "add_connection": "#/components/schemas/AddConnection",
                  "add_stop": "#/components/schemas/AddStop",
                  "change_frequency": "#/components/schemas/ChangeFrequency",
                  "change_travel_time": "#/components/schemas/ChangeTravelTime",
                  "close_stop": "#/components/schemas/CloseStop",
                  "remove_connection": "#/components/schemas/RemoveConnection"
                }
              }
            },
            "type": "array",
            "maxItems": 20,
            "title": "Changes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin_id",
          "destination_id"
        ],
        "title": "JourneyRequest"
      },
      "NetworkOut": {
        "properties": {
          "stops": {
            "items": {
              "$ref": "#/components/schemas/StopOut"
            },
            "type": "array",
            "title": "Stops"
          },
          "routes": {
            "items": {
              "$ref": "#/components/schemas/RouteOut"
            },
            "type": "array",
            "title": "Routes"
          },
          "connections": {
            "items": {
              "$ref": "#/components/schemas/ConnectionOut"
            },
            "type": "array",
            "title": "Connections"
          }
        },
        "type": "object",
        "required": [
          "stops",
          "routes",
          "connections"
        ],
        "title": "NetworkOut",
        "description": "The whole baseline network in one response (used by the map)."
      },
      "NewStops": {
        "properties": {
          "stop_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Stop Ids"
          },
          "journeys": {
            "type": "integer",
            "title": "Journeys"
          },
          "possible": {
            "type": "integer",
            "title": "Possible"
          },
          "average_time_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Time Min"
          }
        },
