# Copy to .env.local and adjust if needed. .env.local is git-ignored.
#
# Only variables prefixed with VITE_ are exposed to browser code.
# Everything here ends up public in the browser: NEVER put secrets
# (API keys, passwords) in frontend env variables.

# Address of the backend API (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
