# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it.

# Groq API key (https://console.groq.com/keys). Without it the app still works,
# only the "Describe a change" AI feature is disabled.
GROQ_API_KEY=

# Optional overrides (defaults shown)
# AI_MODEL=openai/gpt-oss-120b
# AI_TIMEOUT_SECONDS=30
