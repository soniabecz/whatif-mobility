# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it.

# Groq API key (https://console.groq.com/keys). Without it the app still works,
# only the "Describe a change" AI feature is disabled.
GROQ_API_KEY=

# Optional overrides (defaults shown)
# AI_MODEL=openai/gpt-oss-120b
# AI_TIMEOUT_SECONDS=30

# Minutes added to a journey per change of bus, on top of waiting (0-60)
# TRANSFER_PENALTY_MIN=2

# Wait half the route's headway at every boarding (true/false).
# INCLUDE_WAITING=false with TRANSFER_PENALTY_MIN=5 = the model before Day 10.
# INCLUDE_WAITING=true
